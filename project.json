    "Tags": [
      "PowerShell",
      "KeepAChangelog",
      "keep-a-changelog",
      "Changelog",
      "ReleaseNotes",
      "SemanticVersioning",
      "SemVer"
    ],
    "ProjectUri": "https://keepachangelog.ps",
    "ReleaseNotes": "https://keepachangelog.ps",
    "IconUri": "https://keepachangelog.ps/assets/images/favicon.ico",
