{
  "ProjectName": "KeepAChangelog",
  "Description": "PowerShell helpers for creating, validating, and releasing Keep a Changelog files.",
  "Version": "0.2.4",
  "Preamble": [
    "Set-StrictMode -Version Latest"
  ],
  "Manifest": {
